# Port configuration
PORT=8000

# Database configuration (Optional PostgreSQL connection string; leave blank for SQLite)
# DATABASE_URL=postgresql://username:password@localhost:5432/linkedin_tracker
DATABASE_URL=

# Message Broker (Redis connection string)
BROKER_URL=redis://host.docker.internal:6379/0

# LLM Provider: 'mistral' or 'gemini'
LLM_PROVIDER=mistral

# Mistral AI configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Google Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mercure Real-time SSE Hub configuration
MERCURE_PORT=3000
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# Google OAuth 2.0 configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional redirect URI (defaults to http://localhost:8000/api/auth/google/callback if blank)
GOOGLE_REDIRECT_URI=
JWT_SECRET=!ChangeThisAppJWTSecretKeyForUserSessions!
# Set to 'true' to allow Dev Mode login button when Google OAuth is not configured
DEV_AUTH=true
