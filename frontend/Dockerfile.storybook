FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY packages/ui-kit ./packages/ui-kit
RUN cd frontend && npm ci && rm -rf /app/packages/ui-kit/node_modules && ln -s /app/frontend/node_modules /app/packages/ui-kit/node_modules

RUN cd packages/ui-kit && npm run storybook:build

FROM nginx:1.27-alpine
COPY --from=builder /app/packages/ui-kit/storybook-static /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
