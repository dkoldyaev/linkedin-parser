{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui-kit": "pnpm --dir ../packages/ui-kit run build",
    "build": "pnpm --dir ../packages/ui-kit run build && vite build",
    "preview": "vite preview",
    "lint": "oxlint src/ && pnpm --dir ../packages/ui-kit run lint",
    "lint:fix": "oxlint --fix src/ && pnpm --dir ../packages/ui-kit run lint:fix",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write \"src/**/*.{ts,tsx,js,jsx,css,json}\" \"../packages/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check \"src/**/*.{ts,tsx,js,jsx,css,json}\" \"../packages/**/*.{ts,tsx,js,jsx,css,json}\"",
    "lint:boundaries": "pnpm --dir ../packages/ui-kit run lint:boundaries",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir ../packages/ui-kit run typecheck",
    "test": "vitest run",
    "storybook": "pnpm --dir ../packages/ui-kit run storybook",
    "storybook:build": "pnpm --dir ../packages/ui-kit run storybook:build",
    "test:api": "node test_api.mjs"
  },
  "dependencies": {
    "@blueprint/ui-kit": "workspace:*",
    "@floating-ui/react-dom": "^2.1.9",
    "@formkit/auto-animate": "^0.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dismissable-layer": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "compromise": "^14.19.0",
    "lucide-react": "^1.42.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  }
}
