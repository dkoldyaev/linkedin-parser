{
  "manifest_version": 3,
  "name": "Job Tracker Extractor",
  "version": "1.0.0",
  "description": "Parse job vacancies and sync with Job Tracker.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup-dist/index.html",
    "default_title": "Add to Job Tracker"
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://127.0.0.1/*", "<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
